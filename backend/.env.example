# Password reset emails. Without RESEND_API_KEY, reset links are logged to the backend
# console instead of emailed (fine for dev). To go live: sign up at resend.com, verify a
# sending domain (or use the onboarding@resend.dev default for testing), and paste the key.
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_ADDRESS=ak.shop <onboarding@resend.dev>
